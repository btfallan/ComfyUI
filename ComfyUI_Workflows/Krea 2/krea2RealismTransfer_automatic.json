      "mode": 0,
      "inputs": [],
      "outputs": [],
      "title": "About Models",
      "properties": {},
      "widgets_values": [
        "To get the best realistic style transfer you need to use the Raw model with the Turbo LoRA at 0.6 strength.\n\nThis is because more than 1 CFG is needed to disable certain stylized concepts through negative prompting, when the turbo model is limited to 1 CFG.\n\nUsing the Raw model with the Turbo LoRA at 0.6 strength instead allows us to use 2 CFG, solving this problem."
      ],
      "color": "#222",
      "bgcolor": "#000"
    },
